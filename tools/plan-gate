#!/usr/bin/env bash
# Plan-file lifecycle for Claude Code sessions. Plans are temporary artifacts
# in <repo>/.claude/plans/<feature>.md, deleted once the feature ships — the
# durable parts get routed out first (my:capture-learnings). This enforces the
# "deleted, never archived" half and reports state to agents.
#
#   plan-gate list          inventory + the status contract (SessionStart hook)
#   plan-gate check         exit 1 while any plan is `status: shipped`
#   plan-gate install       wire `check` into this repo's pre-push hook
#
# Status lives in each plan's frontmatter: active | queued | blocked | shipped.
# At most one plan may be `active` per working tree; new plans start `queued` so
# writing one mid-flight can't displace the work in progress. Parallel worktrees
# each own an active plan, so a checkout that has merged two of their branches
# legitimately sees more than one. A plan with no frontmatter is unknown, not
# broken — nothing here nags about it or rewrites it.
#
# The frontmatter is not the only evidence, because it is written inside the
# worktree building the plan and stays on that branch until it merges. Every
# other checkout therefore reads a stale status. A live worktree named for a
# plan promotes it to active here regardless — `blocked` and `shipped` excepted,
# being deliberate signals a tree does not refute.

set -uo pipefail

root=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
plans_dir="$root/.claude/plans"

# The first `status:` inside the leading --- frontmatter block, or empty.
plan_status() {
  awk '
    NR == 1 && $0 !~ /^---[[:space:]]*$/ { exit }
    NR == 1 { next }
    /^---[[:space:]]*$/ { exit }
    /^status:[[:space:]]*/ {
      sub(/^status:[[:space:]]*/, "")
      sub(/[[:space:]]+$/, "")
      print
      exit
    }
  ' "$1"
}

# Color states how much attention a section wants, and nothing else — same
# scale agent-board uses, so a glance means the same thing in both tools:
# red blocks you now, yellow wants a decision, cyan is in flight, magenta is
# parked, dim is nothing to do. Only the header line is colored; items stay
# plain so a name is copyable and a command inside a note stays readable.
#
# Both callers are hooks that capture this output — SessionStart reads `list`,
# pre-push reads `check` — and escape codes there are noise an agent reads
# past, so the palette arms only against a terminal. Set on the fd each command
# actually writes to: `list` is stdout, `check` is stderr.
palette() {
  c_reset='' c_title='' c_active='' c_shipped='' c_blocked='' c_idle='' c_warn='' c_stop=''
  [ -t "$1" ] && [ -z "${NO_COLOR:-}" ] || return 0

  c_reset=$'\033[0m'
  c_title=$'\033[1m'
  c_active=$'\033[1;36m'   # in flight
  c_shipped=$'\033[1;33m'  # wants a decision
  c_blocked=$'\033[1;35m'  # parked
  c_idle=$'\033[1;90m'     # nothing to do
  c_warn=$'\033[1;33m'     # the invariant is off
  c_stop=$'\033[1;31m'     # blocking a push right now
}

# Every section renders the same shape, so nothing drifts as sections are added:
#
#   ■ Title  (summary)
#     note line
#
#     item
#     item
#
# Notes carry the action for the whole section — never repeated per item. ■ is
# informational, ⚠ needs a decision. Mirrors the renderer in card-flipping's
# `flip status` (flip/cli/status.py).
section() {
  local color=$1 symbol=$2 title=$3 summary=$4 notes=$5 items=$6

  if [ -n "$summary" ]; then
    printf '\n%s%s %s  (%s)%s\n' "$color" "$symbol" "$title" "$summary" "$c_reset"
  else
    printf '\n%s%s %s%s\n' "$color" "$symbol" "$title" "$c_reset"
  fi

  [ -n "$notes" ] && indent "$notes"

  if [ -n "$items" ]; then
    printf '\n'
    indent "$(printf '%s' "$items" | sort)"
  fi
}

indent() {
  while IFS= read -r line; do
    [ -n "$line" ] && printf '  %s\n' "$line" || printf '\n'
  done <<< "$1"
}

plural() {
  if [ "$1" -eq 1 ]; then printf '%s' "$2"; else printf '%ss' "$2"; fi
}

each_plan() {
  [ -d "$plans_dir" ] || return 0
  for plan in "$plans_dir"/*.md; do
    [ -e "$plan" ] || continue
    printf '%s\n' "$plan"
  done
}

# Directory basenames of every live worktree except this checkout.
#
# A plan is promoted to active inside its own worktree, on that tree's branch,
# so every other checkout keeps seeing the pre-promotion copy of the file. From
# the main checkout a plan being built right now still reads `queued`, and the
# gate would report "no active plan" while a tree is sitting there building it.
# The tree is the fact that does not lag: if one exists for a plan, the plan is
# in flight regardless of what this checkout's copy says.
worktree_names() {
  git -C "$root" worktree list --porcelain 2>/dev/null \
    | awk '/^worktree /{ print substr($0, 10) }' \
    | while IFS= read -r path; do
        [ "$path" = "$root" ] && continue
        basename "$path"
      done
}

# `just worktree <name> FNDR-12` names the tree `fndr-12-<name>` for Linear's
# benefit, while the plan is named for the work — so an issue-id prefix has to
# come off before the two can be compared.
plan_has_worktree() { # plan-name; reads $wt_names from the caller
  local tree
  while IFS= read -r tree; do
    [ -n "$tree" ] || continue
    [ "$tree" = "$1" ] && return 0
    [ "$(printf '%s' "$tree" | sed -E 's/^[a-z]+-[0-9]+-//')" = "$1" ] && return 0
  done <<< "$wt_names"
  return 1
}

# One section per status, most-actionable first. The status contract lives in
# the section notes rather than in a closing paragraph, so each rule sits next
# to the plans it governs; only the rule that belongs to no single status is
# left to the footer.
cmd_list() {
  local active="" shipped="" blocked="" queued="" unknown=""
  local count=0 n_active=0 n_shipped=0 n_blocked=0 n_queued=0 n_unknown=0
  local n_orphan_active=0
  local wt_names
  wt_names=$(worktree_names)

  while IFS= read -r plan; do
    [ -n "$plan" ] || continue
    local status name owned
    status=$(plan_status "$plan")
    name=$(basename "$plan" .md)
    count=$((count + 1))
    owned=no
    plan_has_worktree "$name" && owned=yes

    # A live tree outranks a stale `queued` or a missing status, and only those:
    # `blocked` and `shipped` are deliberate signals that a tree does not refute
    # — a blocked plan with a tree is still blocked, and a shipped one still owes
    # a drain. The file's own claim rides along so nobody reads the promotion as
    # something the frontmatter says.
    if [ "$owned" = yes ] && { [ "$status" = queued ] || [ -z "$status" ]; }; then
      active+="$name  · worktree, file says ${status:-no status}"$'\n'
      n_active=$((n_active + 1))
      continue
    fi

    case "$status" in
      active)
        active+="$name"$'\n'; n_active=$((n_active + 1))
        [ "$owned" = yes ] || n_orphan_active=$((n_orphan_active + 1))
        ;;
      shipped) shipped+="$name"$'\n'; n_shipped=$((n_shipped + 1)) ;;
      blocked) blocked+="$name"$'\n'; n_blocked=$((n_blocked + 1)) ;;
      queued) queued+="$name"$'\n'; n_queued=$((n_queued + 1)) ;;
      *) unknown+="$name"$'\n'; n_unknown=$((n_unknown + 1)) ;;
    esac
  done < <(each_plan)

  [ "$count" -gt 0 ] || return 0

  printf '%splan-gate — %s %s in .claude/plans%s\n' \
    "$c_title" "$count" "$(plural "$count" plan)" "$c_reset"

  [ -n "$active" ] && section "$c_active" "■" "Active" "$n_active $(plural "$n_active" plan)" \
    "In flight. At most one per working tree — parallel worktrees may each own one.
A plan with a live worktree counts as active however its file reads here: the
status flips inside the tree, so this checkout's copy lags until that branch lands." \
    "$active"

  [ -n "$shipped" ] && section "$c_shipped" "⚠" "Shipped" "$n_shipped $(plural "$n_shipped" plan)" \
    "Landed but not drained, and the pre-push gate blocks until they are.
Route the durable parts out (my:capture-learnings), then delete the file." \
    "$shipped"

  [ -n "$blocked" ] && section "$c_blocked" "■" "Blocked" "$n_blocked $(plural "$n_blocked" plan)" \
    "Waiting on something outside the plan." \
    "$blocked"

  [ -n "$queued" ] && section "$c_idle" "■" "Queued" "$n_queued $(plural "$n_queued" plan)" \
    "Where new plans start, so writing one mid-flight can't displace the work in progress." \
    "$queued"

  [ -n "$unknown" ] && section "$c_idle" "■" "No status" "$n_unknown $(plural "$n_unknown" plan)" \
    "No frontmatter — unknown, not broken. Add a \`status:\` line when you next touch one." \
    "$unknown"

  if [ "$n_active" -eq 0 ]; then
    section "$c_warn" "⚠" "No active plan" "" \
      "Ask which queued plan to promote before resuming — never pick by age." ""
  elif [ "$n_orphan_active" -gt 1 ]; then
    section "$c_warn" "⚠" "$n_orphan_active plans active" "" \
      "The rule is one per working tree, and no live tree owns these — so they are
this checkout's, and it can only have one. Demote the ones you are not building." ""
  fi

  local contract
  contract=$(cat <<'CONTRACT'
Plans are temporary artifacts. Set `status: shipped` the moment a plan's last
phase or PR lands, and delete the file once it's drained. Never archive a plan —
git history is the archive.
CONTRACT
  )
  printf '\n%s%s%s\n' "$c_idle" "$contract" "$c_reset"
}

cmd_check() {
  local shipped=()

  while IFS= read -r plan; do
    [ -n "$plan" ] || continue
    [ "$(plan_status "$plan")" = shipped ] && shipped+=("$plan")
  done < <(each_plan)

  [ "${#shipped[@]}" -eq 0 ] && return 0

  {
    printf '%splan-gate — push blocked%s\n' "$c_title" "$c_reset"
    section "$c_stop" "⚠" "Marked shipped, still on disk" \
      "${#shipped[@]} $(plural "${#shipped[@]}" plan)" \
      "A shipped plan is a plan that has not been drained. Route its durable parts
to their homes (my:capture-learnings), delete the file, commit, then push.
Bypass once with: git push --no-verify" \
      "$(printf '%s\n' "${shipped[@]#$root/}")"
  } >&2
  return 1
}

# Where git will actually look for hooks. `core.hooksPath` wins outright when
# set — git ignores .git/hooks entirely — and a relative value is resolved
# against the working tree root.
hooks_dir() {
  local configured
  configured=$(git -C "$root" config core.hooksPath 2>/dev/null) || configured=""

  if [ -z "$configured" ]; then
    echo "$(git -C "$root" rev-parse --git-dir)/hooks"
    return
  fi

  case "$configured" in
    /*) echo "$configured" ;;
    *) echo "$root/$configured" ;;
  esac
}

# A repo whose hooks are a dispatcher over <hook>.d/ directories gets a numbered
# script rather than an edit to a dispatcher this tool doesn't own. 05 so the
# check — milliseconds — runs before whatever suite the repo gates on.
install_dropin() {
  local dir="$1"
  local script="$dir/05-plan-gate"

  if grep -rlq plan-gate "$dir" 2>/dev/null; then
    echo "plan-gate: already wired into $dir"
    return 0
  fi

  cat > "$script" <<'HOOK'
#!/usr/bin/env bash
set -e

# plan-gate: refuse to push while a plan is marked shipped but not yet deleted.
# No-op where the tool isn't installed, so a fresh clone still pushes.
# Does not read stdin — later hooks may need the ref list.
# Skip once with: SKIP=plan-gate git push

command -v plan-gate >/dev/null 2>&1 || exit 0

plan-gate check
HOOK

  chmod +x "$script"
  echo "plan-gate: wired into ${script#$root/} — commit it if that directory is tracked"
}

install_single() {
  local hook="$1"

  if [ -f "$hook" ] && grep -q plan-gate "$hook"; then
    echo "plan-gate: already wired into $hook"
    return 0
  fi

  local block
  block=$(cat <<'HOOK'
# plan-gate: refuse to push while a plan is marked shipped but not yet deleted
if command -v plan-gate >/dev/null 2>&1; then
  plan-gate check || exit 1
fi
HOOK
  )

  # Goes directly under the shebang, not at the end: an existing hook may end in
  # `exit 0`, which would make an appended check dead code that never runs.
  if [ -f "$hook" ]; then
    local tmp="$hook.plan-gate.$$"
    {
      head -n 1 "$hook"
      printf '\n%s\n' "$block"
      tail -n +2 "$hook"
    } > "$tmp" && mv "$tmp" "$hook"
  else
    mkdir -p "$(dirname "$hook")"
    printf '#!/bin/sh\n\n%s\n' "$block" > "$hook"
  fi

  chmod +x "$hook"
  echo "plan-gate: wired into $hook"
}

cmd_install() {
  if ! git -C "$root" rev-parse --git-dir >/dev/null 2>&1; then
    echo "plan-gate: $root is not a git repository" >&2
    return 1
  fi

  local dir
  dir=$(hooks_dir)

  # An earlier install may have written into .git/hooks before this repo
  # adopted core.hooksPath, leaving a check git no longer runs. Say so — a
  # silently inert gate is worse than no gate.
  local bypassed="$(git -C "$root" rev-parse --git-dir)/hooks/pre-push"
  if [ "$dir" != "$(dirname "$bypassed")" ] && [ -f "$bypassed" ] && grep -q plan-gate "$bypassed"; then
    echo "plan-gate: $bypassed has a check git no longer runs (core.hooksPath is set); it can be deleted"
  fi

  if [ -d "$dir/pre-push.d" ]; then
    install_dropin "$dir/pre-push.d"
  else
    install_single "$dir/pre-push"
  fi
}

case "${1:-list}" in
  list) palette 1; cmd_list ;;
  check) palette 2; cmd_check ;;
  install) cmd_install ;;
  *)
    echo "usage: plan-gate [list|check|install]" >&2
    exit 64
    ;;
esac
